rules_version = '2';
// The Yardery FOH checklists. These rules are what protect the data; paste them into
// Firebase console > Firestore Database > Rules, then click Publish.
//
// - Only people signed in through the site (anonymous sign-in) can read or write. Nobody can list other data.
// - Anyone can check a task off, only as themselves (their own device id, the real server time).
// - Only the person who checked a task, or a manager, can uncheck it.
// - Photo tasks: photos are saved with the check and can't be changed or deleted.
// - Closed Mondays and after the nightly lock (30 min after closing) nothing can be checked or unchecked.
// - Nobody can edit a check, or delete a day or week; old days and weeks stay as the record.
// - Only managers can change the task lists (manager page); every save is kept in taskHistory.
// - Managers: the managerIds() list below (or a locations/{locationId}/managers/{device id} document added in the console).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // MANAGERS: device ids per location (copy from Firestore > Data > locations > {location} > devices).
    // Keep in step with "managers" in the page's FOH_CONFIG. After editing, paste this file into Firebase > Rules > Publish.
    function managerIds() {
      return {
        'sanford': ['TjGZ7fcbmAgo4y2skvQPfuH4fJB2',   // Clay
                    'VhBcsd2kwkQao2VjpUeafDtEd0A2',   // added Nov 13 at Clay's request
                    'p4319WV7PBRuX0kDgi98zCDCtB22',   // added Nov 13 at Clay's request (computer)
                    '1hxYPl0wQnbl1KgvV9nJrCEA6y82']   // added Nov 13 at Clay's request
      };
    }
    function isManager(loc) {
      return request.auth.uid in managerIds().get(loc, [])
        || exists(/databases/$(database)/documents/locations/$(loc)/managers/$(request.auth.uid));
    }
    // ===== Closing lock (keep in step with "schedule" in config.js) =====
    // A business day can't be changed on a closed day (Monday), before it starts, or once its lock record
    // locations/{loc}/locks/{day} exists. Phones (and the nightly PDF script) create that record when the
    // 30-minute countdown after closing ends.
    function dayTs(s) { let p = s.split('-'); return timestamp.date(int(p[0]), int(p[1]), int(p[2])); }
    // lock = closing (Sun 8 PM, Tue–Thu 10 PM, Fri–Sat midnight) + 30 min, as UTC (+4 h; in winter this lets the
    // record be made up to 1 hour early, and the phones and script only make it on time)
    function lockTs(s) {
      let w = dayTs(s).dayOfWeek();   // 1 = Monday … 7 = Sunday
      return dayTs(s) + duration.value((w == 7 ? 20 : (w == 5 || w == 6 ? 24 : 22)) * 60 + 30 + 240, 'm');
    }
    function openDay(loc, s) {
      return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && dayTs(s).dayOfWeek() != 1
        && dayTs(s) < request.time + duration.value(1, 'd')
        && !exists(/databases/$(database)/documents/locations/$(loc)/locks/$(s));
    }
    function inWeek(day, monday) {
      return day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && dayTs(day) >= dayTs(monday) && dayTs(day) < dayTs(monday) + duration.value(7, 'd');
    }

    function inMonth(day, first) {
      return first.matches('^[0-9]{4}-[0-9]{2}-01$') && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && day.split('-')[0] == first.split('-')[0] && day.split('-')[1] == first.split('-')[1];
    }

    function validCheck(task) {
      let d = request.resource.data;
      return d.keys().hasOnly(['task', 'name', 'uid', 'day', 'at', 'tappedAt', 'photos', 'slots'])
        && (!('photos' in d) || (d.photos is list && d.photos.size() <= 4))
        && (!('slots' in d) || (d.slots is list && d.slots.size() <= 4))
        && d.keys().hasAll(['task', 'name', 'uid', 'at', 'tappedAt'])
        && d.task == task
        && d.uid == request.auth.uid
        && d.name is string && d.name.size() > 0 && d.name.size() <= 20
        && d.at == request.time
        && d.tappedAt is timestamp
        && d.tappedAt < request.time + duration.value(15, 'm')
        && d.tappedAt > request.time - duration.value(8, 'd');
    }

    function validTasks() {
      let d = request.resource.data;
      return d.keys().hasOnly(['daily', 'weekly', 'monthly', 'positions', 'updatedAt', 'updatedBy', 'updatedByUid'])
        && d.daily is list && d.weekly is list && d.positions is list && (!('monthly' in d) || d.monthly is list)
        && d.updatedBy is string && d.updatedBy.size() <= 20
        && d.updatedByUid == request.auth.uid
        && d.updatedAt == request.time;
    }

    match /locations/{loc} {
      // Checks: locations/{loc}/days/{YYYY-MM-DD}, weeks/{Monday YYYY-MM-DD} and months/{YYYY-MM-01} /checks/{taskId}
      match /{period}/{sheet}/checks/{task} {
        allow read: if signedIn() && period in ['days', 'weeks', 'months'];
        allow create: if signedIn()
          && loc.matches('^[a-z0-9-]{1,40}$')
          && period in ['days', 'weeks', 'months']
          && sheet.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && task.matches('^[a-z0-9-]{1,40}$')
          && validCheck(task)
          && (period == 'days' ? request.resource.data.day == sheet
              : period == 'weeks' ? inWeek(request.resource.data.day, sheet) : inMonth(request.resource.data.day, sheet))
          && openDay(loc, request.resource.data.day);
        allow delete: if signedIn() && period in ['days', 'weeks', 'months']
          && (resource.data.uid == request.auth.uid || isManager(loc))
          && openDay(loc, resource.data.get('day', sheet));
        allow update: if false;
      }

      // Task lists, edited on the manager page (manage.html). Every phone reads them; only managers save them.
      // Each save is also kept in taskHistory, so an older list can be brought back.
      match /config/{docId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && docId == 'tasks' && isManager(loc) && validTasks();
        allow delete: if false;
      }
      match /taskHistory/{id} {
        allow read: if signedIn() && isManager(loc);
        allow create: if signedIn() && isManager(loc) && validTasks();
        allow update, delete: if false;
      }

      // Photos for Photo-tagged tasks, taken with the camera on the staff page (shrunk JPEG, kept as records).
      match /photos/{id} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['task', 'period', 'sheet', 'day', 'slot', 'name', 'uid', 'at', 'img'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.task is string && request.resource.data.task.size() <= 40
          && request.resource.data.period in ['days', 'weeks', 'months']
          && request.resource.data.sheet is string && request.resource.data.sheet.size() == 10
          && request.resource.data.slot is string && request.resource.data.slot.size() <= 60
          && request.resource.data.name is string && request.resource.data.name.size() <= 20
          && request.resource.data.img is string && request.resource.data.img.size() < 700000
          && request.resource.data.day is string && openDay(loc, request.resource.data.day);
        allow update, delete: if false;
      }

            // Lock records: anyone signed in can create one, but only after that day's lock time; never changed or removed.
      match /locks/{day} {
        allow read: if signedIn();
        allow create: if signedIn() && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time
          && request.time >= lockTs(day);
        allow update, delete: if false;
      }

      // Each phone's first name, tied to its anonymous user id (so it is remembered and managers can find a device).
      match /devices/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isManager(loc));   // managers see names to assign tasks
        allow create, update: if signedIn() && request.auth.uid == uid
          && loc.matches('^[a-z0-9-]{1,40}$')
          && request.resource.data.keys().hasOnly(['name', 'lastSeen'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
          && request.resource.data.lastSeen == request.time;
        allow delete: if false;
      }

      // Managers: a phone can see whether it is a manager. Only the Firebase console can add or remove one.
      match /managers/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }
  }
}
